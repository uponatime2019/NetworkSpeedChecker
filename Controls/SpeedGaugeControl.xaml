<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NetworkSpeedChecker.Controls.SpeedGaugeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="370" Height="370">
        <!-- 240° speedometer sweep: soft outer halo, dim track, vivid progress arc -->
        <Path x:Name="HaloPath"
              Stroke="#14F97316"
              StrokeThickness="32"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>
        <Path x:Name="TrackPath"
              Stroke="{ThemeResource TrackBrush}"
              StrokeThickness="17"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>
        <Path x:Name="ProgressPath"
              Stroke="{StaticResource AccentOrangeBrush}"
              StrokeThickness="17"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
            <TextBlock x:Name="PhaseText"
                       Text="READY"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                <TextBlock x:Name="ValueText"
                           Text="—"
                           FontSize="65"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock x:Name="UnitText"
                           Text=""
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12"/>
            </StackPanel>
            <TextBlock x:Name="SubText"
                       Text=""
                       FontSize="16"
                       Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
