<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetworkSpeedChecker.Views.FixInternetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:NetworkSpeedChecker.Services"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ContentBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel MaxWidth="1050" Margin="28,24,28,32" Spacing="20" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <TextBlock Text="F I X   I N T E R N E T   &amp;   S P E E D   U P"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan network health, flush DNS cache, and optimize your Wi-Fi band for maximum speed"
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ================= 1. Scan & Speed Up Action Card ================= -->
                <Border Style="{StaticResource PanelCardStyle}" BorderBrush="{StaticResource AccentTealBrush}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="One-Click Network Health &amp; Speedup"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Scans connection latency, router health, and clears stale DNS cache."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                            </StackPanel>
                            <Button x:Name="ScanButton"
                                    Grid.Column="1"
                                    Content="Scan &amp; Optimize"
                                    Style="{StaticResource HeroButtonStyle}"
                                    FontSize="16"
                                    Padding="28,12"
                                    MinWidth="180"
                                    Click="ScanButton_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0891B2" Offset="0"/>
                                        <GradientStop Color="#14B8A6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Grid>

                        <!-- Scanning indicator -->
                        <StackPanel x:Name="ScanningPanel" Visibility="Collapsed" Spacing="10" Margin="0,8,0,0">
                            <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock x:Name="ScanningStepText" Text="Initializing diagnostic tests…" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Scan Results Container -->
                        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Spacing="12" Margin="0,6,0,0">
                            <!-- Overall banner -->
                            <Border x:Name="StatusBanner" CornerRadius="10" Padding="14,10" Background="#1A14B8A6" BorderBrush="#3314B8A6" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="StatusBannerIcon" Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource AccentTealBrush}"/>
                                    <TextBlock x:Name="StatusBannerText" Text="Connection Healthy" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Items List -->
                            <ListView x:Name="DiagnosticList" SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:DiagnosticItem">
                                        <Border Background="{ThemeResource CardBrush}"
                                                BorderBrush="{ThemeResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="{x:Bind Glyph}"
                                                          Foreground="{x:Bind StatusBrush}"
                                                          FontSize="16"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Status}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 2. Wi-Fi 2.4 GHz vs 5 GHz Speed Guide Card ================= -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="Wi-Fi Band Guide: 2.4 GHz vs. 5 GHz"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Most modern routers broadcast two separate frequencies. Choosing the right band has the biggest impact on your speed."
                                       Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>

                        <!-- Recommendation Callout -->
                        <Border CornerRadius="12" Padding="16,14" Background="#220891B2" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentTealBrush}" Margin="0,0,14,0">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Recommendation: Always connect to 5 GHz (or 6 GHz) for High Speed"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="5 GHz offers up to 3x–10x higher speeds (300 to 1,000+ Mbps), ultra-low ping for gaming, and eliminates microwave/Bluetooth interference."
                                               FontSize="14"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="Open Wi-Fi Settings"
                                        Style="{StaticResource HeaderButtonStyle}"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"
                                        Click="OpenWifiSettingsButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Side by Side Band Comparison -->
                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 2.4 GHz Card -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="#33D97706">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border CornerRadius="6" Background="#22D97706" Padding="8,4">
                                            <TextBlock Text="2.4 GHz" FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                                        </Border>
                                        <TextBlock Text="Long Range / Lower Speed" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="• Typical Speeds: 40 – 90 Mbps (Crowded channels)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Range: Covers long distances and easily passes through walls." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Interference: High. Shared with Bluetooth, microwaves, and neighbor Wi-Fi." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Best For: Smart home sensors, printers, light browsing from another room." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 5 GHz Card (Recommended) -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="{StaticResource AccentTealBrush}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border CornerRadius="6" Background="#2216A34A" Padding="8,4">
                                            <TextBlock Text="5 GHz (Recommended)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                        </Border>
                                        <TextBlock Text="Ultra-Fast / Low Latency" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="• Typical Speeds: 300 – 1,200+ Mbps (Wide 80/160 MHz channels)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Range: Medium. Best performance within the same or adjacent room." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Interference: Very Low. 24 non-overlapping channels avoid congestion." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <TextBlock Text="• Best For: 4K/8K streaming, competitive gaming, file downloads, Zoom calls." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- How to switch to 5GHz instructions -->
                        <Border Style="{StaticResource MetricCardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="How to switch to 5 GHz on Windows:" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="1. Click the Wi-Fi icon on the Windows Taskbar (or the 'Open Wi-Fi Settings' button above)." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="2. Look at your available Wi-Fi networks for your network name with '_5G', '_5GHz', or '-5G' (e.g., 'HomeNetwork_5G')." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="3. Connect to the 5 GHz network and check 'Connect automatically'." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="4. If your router uses a single name (Smart Connect / Band Steering), stay closer to your router so it automatically switches you to 5 GHz." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ================= 3. Additional Speed-Up Tips ================= -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BE;" FontSize="18" Foreground="{StaticResource AccentTealBrush}"/>
                            <TextBlock Text="More Pro Tips for Faster Internet"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="• Use an Ethernet Cable: If possible, a wired LAN cable provides maximum bandwidth and zero jitter." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Restart Router Regularly: Power cycling clears router RAM and re-negotiates the cleanest Wi-Fi channels." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Pause Background Sync: Turn off large cloud backups or torrent clients while performing speed tests or gaming." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Use Fast DNS: Configure Cloudflare (1.1.1.1) or Google DNS (8.8.8.8) on your PC or router." FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
