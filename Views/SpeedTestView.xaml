<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetworkSpeedChecker.Views.SpeedTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NetworkSpeedChecker.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Background="{ThemeResource ContentBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel MaxWidth="1050" Margin="28,24,28,32" Spacing="22" HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="3" HorizontalAlignment="Center">
                    <TextBlock Text="I N T E R N E T   S P E E D   T E S T"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="One tap measures ping, download and upload over your real connection"
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error / status InfoBar -->
                <InfoBar x:Name="StatusInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         CornerRadius="10"
                         HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <Button x:Name="RetryButton"
                                Content="Retry"
                                Style="{StaticResource HeaderButtonStyle}"
                                Click="RetryButton_Click"/>
                    </StackPanel>
                </InfoBar>

                <!-- ================= Idle: start control ================= -->
                <StackPanel x:Name="IdlePanel"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <Button x:Name="StartTestButton"
                            Content="START TEST"
                            Style="{StaticResource HeroButtonStyle}"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Start the internet speed test"
                            Click="StartTestButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0891B2" Offset="0"/>
                                <GradientStop Color="#14B8A6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="Automatic server selection"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="IdleServerLabel"
                                   Text="Server: Cloudflare"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================= Running / complete: gauge ================= -->
                <StackPanel x:Name="GaugePanel"
                            Spacing="12"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <controls:SpeedGaugeControl x:Name="Gauge"/>
                    <ProgressBar x:Name="OverallProgressBar"
                                 Minimum="0" Maximum="100"
                                 Width="360"
                                 Height="8"
                                 CornerRadius="4"
                                 Foreground="{StaticResource AccentOrangeBrush}"
                                 Background="{ThemeResource TrackBrush}"
                                 HorizontalAlignment="Center"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel test"
                            Style="{StaticResource HeaderButtonStyle}"
                            HorizontalAlignment="Center"
                            MinWidth="150"
                            Margin="0,6,0,0"
                            Click="CancelButton_Click">
                        <Button.Foreground>
                            <SolidColorBrush Color="#B45309"/>
                        </Button.Foreground>
                    </Button>

                    <!-- Completed actions -->
                    <StackPanel x:Name="CompletedActions"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="RetestButton" Content="Test again" Style="{StaticResource HeaderButtonStyle}" Click="StartTestButton_Click"/>
                        <Button x:Name="ShareButton" Content="Share" Style="{StaticResource HeaderButtonStyle}" Click="ShareButton_Click"/>
                        <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource HeaderButtonStyle}" Click="CopyButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================= Detailed results (completed): download and upload as separate sections ================= -->
                <Border x:Name="ResultsDetailPanel"
                        Style="{StaticResource PanelCardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="Detailed results"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="ResultsTimestamp"
                                       Text=""
                                       Style="{StaticResource PageSubtitleStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Wide host: download | upload over latency | server -->
                        <Grid x:Name="DetailCardsGrid" ColumnSpacing="14" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- DOWNLOAD section -->
                            <Border x:Name="DownloadDetailCard" Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="#3306B6D4">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource AccentCyanBrush}"/>
                                            <TextBlock Text="DOWNLOAD" Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <Border x:Name="DownloadRatingBadge"
                                                HorizontalAlignment="Right"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Background="#2216A34A">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse x:Name="DownloadRatingDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}"/>
                                                <TextBlock x:Name="DownloadRatingLabel" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="DownloadDetailValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text="Mbps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DownloadMetaText" Text="" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DownloadVerdictText" Text="" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- UPLOAD section -->
                            <Border x:Name="UploadDetailCard" Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="#3314B8A6">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="{StaticResource AccentTealBrush}"/>
                                            <TextBlock Text="UPLOAD" Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <Border x:Name="UploadRatingBadge"
                                                HorizontalAlignment="Right"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Background="#2216A34A">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse x:Name="UploadRatingDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}"/>
                                                <TextBlock x:Name="UploadRatingLabel" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="UploadDetailValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text="Mbps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UploadMetaText" Text="" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="UploadVerdictText" Text="" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- LATENCY section -->
                            <Border x:Name="LatencyDetailCard" Grid.Row="1" Grid.Column="0"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="#337C8CF8">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE916;" FontSize="15" Foreground="{StaticResource AccentVioletBrush}"/>
                                            <TextBlock Text="LATENCY" Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <Border x:Name="PingRatingBadge"
                                                HorizontalAlignment="Right"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Background="#2216A34A">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse x:Name="PingRatingDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}"/>
                                                <TextBlock x:Name="PingRatingLabel" Text="—" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="PingDetailValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text="ms" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LatencyMetaText" Text="" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LatencyVerdictText" Text="" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- SERVER & session section -->
                            <Border x:Name="ServerDetailCard" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource MetricCardStyle}"
                                    BorderBrush="#3338BDF8">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="15" Foreground="{StaticResource AccentSkyBrush}"/>
                                        <TextBlock Text="SERVER" Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ServerDetailValue" Text="Cloudflare" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="ServerMetaText" Text="" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Narrow-window stack of detail cards (swapped in code) -->
                        <StackPanel x:Name="DetailCardsStack" Visibility="Collapsed" Spacing="12"/>

                        <!-- Verdict + suitability chips -->
                        <TextBlock x:Name="VerdictText"
                                   Text=""
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <StackPanel x:Name="SuitabilityChips" Orientation="Horizontal" Spacing="8"/>
                    </StackPanel>
                </Border>

                <!-- Metric cards -->
                <Grid x:Name="MetricCardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40"/>
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>

                    <!-- Ping -->
                    <Border x:Name="PingCard" Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" FontSize="15" Foreground="{StaticResource AccentVioletBrush}"/>
                                <TextBlock Text="PING" Style="{StaticResource CardCaptionStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="PingValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="ms" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                            </StackPanel>
                            <TextBlock x:Name="PingHint" Text="latency" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Download -->
                    <Border x:Name="DownloadCard" Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="DOWNLOAD" Style="{StaticResource CardCaptionStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="DownloadValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Mbps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                            </StackPanel>
                            <TextBlock x:Name="DownloadHint" Text="downlink speed" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Upload -->
                    <Border x:Name="UploadCard" Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="{StaticResource AccentTealBrush}"/>
                                <TextBlock Text="UPLOAD" Style="{StaticResource CardCaptionStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="UploadValue" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Mbps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                            </StackPanel>
                            <TextBlock x:Name="UploadHint" Text="uplink speed" Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Narrow-window stack of metric cards (swapped in code) -->
                <StackPanel x:Name="MetricCardsStack" Visibility="Collapsed" Spacing="10"/>

                <!-- Server footer -->
                <TextBlock x:Name="ServerFooter"
                           Text="Server: Cloudflare • Automatic selection"
                           Style="{StaticResource PageSubtitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
