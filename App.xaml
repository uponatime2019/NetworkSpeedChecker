<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NetworkSpeedChecker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetworkSpeedChecker">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentBgBrush" Color="#F4F7FB"/>
                    <SolidColorBrush x:Key="ContentGridBrush" Color="#E8EDF5"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E8F2"/>
                    <SolidColorBrush x:Key="CardShadowBrush" Color="#14233F14"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F1B2D"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6B82"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SubtleChipBrush" Color="#EDF2F9"/>
                    <SolidColorBrush x:Key="SubtleChipBorderBrush" Color="#DCE5F0"/>
                    <SolidColorBrush x:Key="TrackBrush" Color="#E4EAF3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentBgBrush" Color="#0D1522"/>
                    <SolidColorBrush x:Key="ContentGridBrush" Color="#182338"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#16202F"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#253248"/>
                    <SolidColorBrush x:Key="CardShadowBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF2F9"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A4BC"/>
                    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SubtleChipBrush" Color="#1C2940"/>
                    <SolidColorBrush x:Key="SubtleChipBorderBrush" Color="#2B3A55"/>
                    <SolidColorBrush x:Key="TrackBrush" Color="#223049"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brand palette: navy chrome, cyan/teal data accents, warm orange for active progress. -->
            <Color x:Key="AccentCyanColor">#06B6D4</Color>
            <Color x:Key="AccentTealColor">#14B8A6</Color>
            <Color x:Key="AccentOrangeColor">#F97316</Color>
            <Color x:Key="AccentSkyColor">#38BDF8</Color>
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4"/>
            <SolidColorBrush x:Key="AccentTealBrush" Color="#14B8A6"/>
            <SolidColorBrush x:Key="AccentSkyBrush" Color="#38BDF8"/>
            <SolidColorBrush x:Key="AccentOrangeBrush" Color="#F97316"/>
            <SolidColorBrush x:Key="AccentVioletBrush" Color="#7C8CF8"/>
            <SolidColorBrush x:Key="GoodBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="BadBrush" Color="#EF4444"/>

            <!-- Chrome (always navy, both themes) -->
            <SolidColorBrush x:Key="ChromeBrush" Color="#0E1B31"/>
            <SolidColorBrush x:Key="ChromeHighBrush" Color="#16274A"/>
            <SolidColorBrush x:Key="ChromeTextBrush" Color="#DCE6F5"/>
            <SolidColorBrush x:Key="ChromeTextDimBrush" Color="#8CA0BE"/>

            <!-- NavigationView: dark navy pane in both themes -->
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="#0E1B31"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#C3D0E4"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="#5D6F8C"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundChecked" Color="#4DD9EE"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPointerOver" Color="#4DD9EE"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPressed" Color="#4DD9EE"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#22D3EE"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A2C4F"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#213761"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundChecked" Color="#213761"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#213761"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#28406F"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#28406F"/>
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#1F3050"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>

            <!-- Card container -->
            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18,16"/>
            </Style>

            <Style x:Key="PanelCardStyle" TargetType="Border" BasedOn="{StaticResource MetricCardStyle}">
                <Setter Property="Padding" Value="20,18"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <!-- Large numeric reading -->
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="46"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>

            <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            </Style>

            <!-- Big pill button with gradient (used for START TEST) -->
            <Style x:Key="HeroButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                <Setter Property="Padding" Value="52,22"/>
                <Setter Property="CornerRadius" Value="34"/>
                <Setter Property="MinWidth" Value="290"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.9"/>
                                                <Setter Target="GlowBorder.Opacity" Value="0.55"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.78"/>
                                                <Setter Target="GlowBorder.Opacity" Value="0.25"/>
                                                <Setter Target="ContentScale.ScaleX" Value="0.98"/>
                                                <Setter Target="ContentScale.ScaleY" Value="0.98"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.45"/>
                                                <Setter Target="GlowBorder.Opacity" Value="0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="GlowBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="40"
                                        Margin="-4"
                                        Opacity="0.3"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="RootBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#59FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid x:Name="ContentGrid" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="ContentScale"/>
                                        </Grid.RenderTransform>
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"
                                            Margin="{TemplateBinding Padding}"
                                            TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact secondary button used in page headers -->
            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
